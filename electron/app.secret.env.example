# Copy to  electron/app.secret.env  and fill in before running  npm run dist:installer
# Gitignored. Shipped at package time as  resources/app.secret.env  (next to the .exe).
# If the packaged app cannot connect, the hardcoded fallback in
# backend/src/db/connect.js still applies — restore these values and rebuild.
JWT_SECRET=
MONGO_URI=

{
  "name": "invoicepro-desktop",
  "version": "1.0.0",
  "description": "InvoicePro Desktop Application with persistent local MongoDB storage",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "node scripts/electron-dev.cjs",
    "backend": "npm --prefix backend run dev",
    "frontend": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "electron:dev": "node scripts/electron-dev.cjs",
    "electron:start": "electron .",
    "electron:build": "npm run dist:installer",
    "dist:win": "npm run frontend:build && npx cross-env CSC_IDENTITY_AUTO_DISCOVERY=false WIN_CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis portable",
    "dist:installer": "npm run frontend:build && npx cross-env CSC_IDENTITY_AUTO_DISCOVERY=false WIN_CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis",
    "dist:portable": "npm run frontend:build && npx cross-env CSC_IDENTITY_AUTO_DISCOVERY=false WIN_CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win portable",
    "license:keygen": "node tools/license-cli/keygen.js",
    "license:issue": "node tools/license-cli/issue.js",
    "license:revoke": "node tools/license-cli/revoke.js",
    "license:extend": "node tools/license-cli/extend.js",
    "license:update": "node tools/license-cli/update.js",
    "license:deactivate": "node tools/license-cli/deactivate.js",
    "license:list": "node tools/license-cli/list.js",
    "license:selftest": "node tools/license-cli/selftest.js",
    "license:statetest": "node tools/license-cli/state-test.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:licensing": "node --test \"tests/licensing/*.test.js\"",
    "client:build": "node scripts/client-build.cjs"
  },
  "build": {
    "appId": "com.nexussuite.desktop",
    "productName": "NexusSuite",
    "executableName": "NexusSuite",
    "icon": "electron/icon.ico",
    "directories": {
      "output": "dist-installer"
    },
    "afterPack": "scripts/afterPack.cjs",
    "files": [
      "electron/**/*",
      "backend/**/*",
      "frontend/dist/**/*",
      "package.json",
      "!**/.env",
      "!**/.env.*",
      "!electron/app.env",
      "!electron/app.secret.env",
      "!electron/app.secret.env.example",
      "!tools/**",
      "!dist-licenses/**",
      "!**/*.private.pem",
      "!backend/src/scripts/**"
    ],
    "extraFiles": [
      {
        "from": "backend/node_modules",
        "to": "resources/backend/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "electron/app.env",
        "to": "app.env"
      },
      {
        "from": "electron/app.secret.env",
        "to": "app.secret.env"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "icon": "electron/icon.ico",
      "publisherName": "NexusSuite",
      "verifyUpdateCodeSignature": false,
      "forceCodeSigning": false,
      "certificateFile": null,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nexus Suite Desktop Application",
      "artifactName": "NexusSuite-Windows-Installer.exe"
    },
    "portable": {
      "artifactName": "NexusSuite.exe",
      "unpackDirName": "NexusSuite"
    }
  }
,
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb-memory-server": "^10.0.0",
    "mongoose": "^8.0.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "wait-on": "^7.2.0"
  }
}

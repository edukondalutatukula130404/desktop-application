# ─────────────────────────────────────────────────────────────────────────────
# tools/license-cli/.env.license   —   OFFLINE LICENSE OPERATOR CONFIG
#
# Copy to  tools/license-cli/.env.license  and fill in.
# This file is gitignored. It is NEVER shipped in the .exe and NEVER deployed.
# It contains the admin MongoDB URI and points at the private signing key.
# ─────────────────────────────────────────────────────────────────────────────

# Which signing key to use (must have a matching entry in
# backend/src/licensing/publicKeys.js and a private PEM in tools/license-cli/keys/).
LICENSE_KEY_ID=nxs-dev-2026

# Optional: explicit path to the private key PEM. If omitted, the CLI looks for
# tools/license-cli/keys/<LICENSE_KEY_ID>.private.pem
# LICENSE_PRIVATE_KEY_PATH=

# Admin connection to the SAME Atlas cluster the app uses. Uses YOUR full-access
# credentials — this URI is only ever read on your machine by the CLI.
LICENSE_ADMIN_MONGO_URI=

# Product + defaults applied when issuing, unless overridden by CLI flags.
PRODUCT_ID=nexussuite-desktop
DEFAULT_EDITION=standard
DEFAULT_FEATURES=invoicing,backup,multi-device
DEFAULT_MAX_ACTIVATIONS=2
DEFAULT_BINDING_MODE=soft
DEFAULT_OFFLINE_GRACE_HOURS=72
